# ============================================================
# ARREST GAME
# File : arrest.sk
# Version : v0.0.05
#
# ゲーム開始・停止・状態確認
#
# v0.0.05
# ・/arrest start の開始演出を追加
# ・3 → 2 → 1 → START! と効果音
# ・既存のon / off / statusの動作は変更なし
# ============================================================

command /arrest [<text>]:

    trigger:

        if arg-1 is "on":

            # ====================================================
            # すでに実行中なら再起動しない
            # ====================================================

            if {arrest::enabled} is true:
                send "&e[ARREST GAME] すでに実行中です。"
                stop

            delete {arrest::enabled}
            delete {arrest::world}
            delete {arrest::jail::*}
            delete {arrest::player::*}

            arrest_load_general_config()
            arrest_load_crime_config()

            set {arrest::world} to world of player
            set {arrest::enabled} to true

            send "&a[ARREST GAME] 判定を開始しました。"
            send "&7対象ワールド：%{arrest::world}%"
            send "&7Version：v0.0.05"
            stop


        if arg-1 is "off":

            set {arrest::enabled} to false

            send "&c[ARREST GAME] 判定を停止しました。"
            stop


        if arg-1 is "start":

            loop all players:
                send title "&e&l3" with subtitle "" to loop-player for 1 second
                play sound "block.note_block.pling" with volume 1 and pitch 1 to loop-player

            wait 1 second

            loop all players:
                send title "&e&l2" with subtitle "" to loop-player for 1 second
                play sound "block.note_block.pling" with volume 1 and pitch 1 to loop-player

            wait 1 second

            loop all players:
                send title "&e&l1" with subtitle "" to loop-player for 1 second
                play sound "block.note_block.pling" with volume 1 and pitch 1 to loop-player

            wait 1 second

            loop all players:
                send title "&a&lSTART!" with subtitle "" to loop-player for 2 seconds
                play sound "entity.player.levelup" with volume 1 and pitch 1 to loop-player

            stop


        if arg-1 is "status":

            if {arrest::enabled} is true:
                send "&a[ARREST GAME] ON"
                send "&7対象ワールド：%{arrest::world}%"
            else:
                send "&c[ARREST GAME] OFF"
            stop


        send "&e/arrest on"
        send "&e/arrest off"
        send "&e/arrest start"
        send "&e/arrest status"