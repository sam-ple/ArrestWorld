# ============================================================
# ARREST GAME
# File : crime/mob.sk
#
# 犯罪：なんかかわいそう罪
#
# プレイヤーが敵対しないモブを攻撃した場合に逮捕
# ※ 動物だけではなく魚・イカなども対象
#
# ============================================================


# ============================================================
# エンティティにダメージを与えた
# ============================================================

on damage of entity:

    # ========================================================
    # 攻撃者がプレイヤーの場合のみ
    # ========================================================

    attacker is a player

    # ========================================================
    # 攻撃されたモブを判定
    # ========================================================

    if victim is allay:
        arrest_crime(attacker, "mob")
        stop

    if victim is armadillo:
        arrest_crime(attacker, "mob")
        stop

    if victim is axolotl:
        arrest_crime(attacker, "mob")
        stop

